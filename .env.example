# Copier ce fichier vers .env avant de lancer le pipeline :
#   cp .env.example .env
#
# Les valeurs ci-dessous sont celles d'un environnement de developpement local
# et sont reprises telles quelles par docker-compose.yml. Elles ne protegent
# rien : le conteneur PostgreSQL n'est joignable que depuis la machine hote.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=voting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Parametres de la simulation ---
# Nombre de votants generes par main.py
NB_VOTANTS=1000
# Nombre de candidats generes par main.py
NB_CANDIDATS=3
# Profils recuperes par requete sur randomuser.me (max 5000)
TAILLE_LOT_PROFILS=500
# Pause entre deux votes dans voting.py, en secondes. 0 = debit maximal.
DELAI_ENTRE_VOTES=0
